import java.util.Scanner;
class AdvancedCalculator 
{
    public int modulus(int a, int b) 
{
        if (b == 0) 
        {
            return 0;
        }
        return a % b;
    }

    public double power(double base, double exponent) 
    {
        return Math.pow(base, exponent);
    }

    public double squareRoot(double num) 
    {
        if (num < 0) {
            return 0;
        }
        return Math.sqrt(num);
    }
}
class Calculator extends AdvancedCalculator 
    {
    public int add(int a, int b) {
        return a + b;
    }
    public double add(double a, double b) {
        return a + b;
    }
    public int subtract(int a, int b) {
        return a - b;
    }
    public double subtract(double a, double b) {
        return a - b;
    }
    public int multiply(int a, int b) {
        return a * b;
    }
    public double multiply(double a, double b) {
        return a * b;
    }
    public double divide(double a, double b) {
        if (b == 0) {
            throw new ArithmeticException("Cannot divide by zero");
        }
        return a / b;
    }
}
public class Task01 
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Calculator calc = new Calculator();
        System.out.print("Enter the number = ");
        double num1 = sc.nextDouble();
        System.out.print("Enter another number = ");
        double num2 = sc.nextDouble();
        System.out.println("\nArithmetic Operations:");
        System.out.println("1. Addition");
        System.out.println("2. Subtraction");
        System.out.println("3. Multiplication");
        System.out.println("4. Division");
        System.out.print("Enter your choice (1-4): ");
        int choice = sc.nextInt();
        switch (choice) 
 {
            case 1:
                if (num1 % 1 == 0 && num2 % 1 == 0) {
        System.out.println("Addition of numbers = " + calc.add((int) num1, (int) num2));
                } else {
                    System.out.println("Addition of numbers = " + calc.add(num1, num2));
                }
                break;
            case 2:
                if (num1 % 1 == 0 && num2 % 1 == 0) {
                    System.out.println("Subtraction of numbers = " + calc.subtract((int) num1, (int) num2));
                } else {
                    System.out.println("Subtraction of numbers = " + calc.subtract(num1, num2));
                }
                break;
            case 3:
                if (num1 % 1 == 0 && num2 % 1 == 0) {
                    System.out.println("Multiplication of numbers = " + calc.multiply((int) num1, (int) num2));
                } else {
                    System.out.println("Multiplication of numbers = " + calc.multiply(num1, num2));
                }
                break;
            case 4:
                try {
                    System.out.println("Division of numbers = " + calc.divide(num1, num2));
                } catch (ArithmeticException e) {
                    System.out.println("Error: " + e.getMessage());
                }
                break;
            default:
                System.out.println("Invalid choice!");
        }
        sc.close();
    }
}
